# Copy to .env and fill in. Never commit the real file.
PORT=8080
NODE_ENV=development

# DigitalOcean Managed Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/alterego
DATABASE_SSL=false

# Admin API key for content publishing. Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# Google Play server-to-server verification (service account JSON, base64 encoded)
GOOGLE_SERVICE_ACCOUNT_B64=
ANDROID_PACKAGE_NAME=com.alterego.app

# Comma separated allowed origins for the admin console. Mobile clients do not need CORS.
CORS_ORIGINS=http://localhost:5173

# Google Play real-time developer notifications.
# Preferred: OIDC on the Pub/Sub push subscription.
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Fallback when OIDC is not configured. Generate with: openssl rand -hex 32
PUBSUB_SHARED_SECRET=
